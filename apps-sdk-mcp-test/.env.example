PORT=8787
MCP_PATH=/mcp
MCP_TEST_NAME=openceo-chatgpt-connector
MCP_TEST_AUTH_MODE=none

# Base publico del conector. Ejemplo:
# APP_PUBLIC_BASE_URL=https://abc123.ngrok.app
APP_PUBLIC_BASE_URL=

# OAuth 2.1 para ChatGPT. Por defecto usa un issuer de prueba embebido
# en /oauth del mismo servidor. Usa external solo si quieres Auth0/Okta/etc.
MCP_TEST_OAUTH_PROVIDER=embedded
MCP_TEST_OAUTH_ISSUER_URL=
MCP_TEST_OAUTH_RESOURCE=
MCP_TEST_OAUTH_AUDIENCE=
MCP_TEST_OAUTH_SCOPES=connector.access
MCP_TEST_OAUTH_JWKS_URI=
MCP_TEST_OAUTH_AUTO_APPROVE=true

# Usuario demo del issuer embebido
MCP_TEST_DEMO_USER_SUB=demo-user
MCP_TEST_DEMO_USER_EMAIL=demo@example.com
MCP_TEST_DEMO_USER_NAME=Demo User
