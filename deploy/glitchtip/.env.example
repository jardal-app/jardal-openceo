# Copiar a glitchtip.env (NO versionar: secretos del servicio).
# glitchtip.env vive junto al compose en el host, fuera de git.

# Postgres propia (requerida: PostgreSQL >= 14).
GLITCHTIP_DB_PASSWORD=cambiar-contrasena-larga-aleatoria

# Clave Django del servidor GlitchTip (cadena larga aleatoria).
SECRET_KEY=cambiar-clave-larga-aleatoria

# Dominio interno de la UI (solo tunel SSH salvo allowlist del Owner).
GLITCHTIP_DOMAIN=http://127.0.0.1:8080

# Host de ingesta tras el entrypoint ligado a 127.0.0.1.
GLITCHTIP_INGEST_HOST=ingesta.localhost

# Correo opcional (vacio = avisos por correo apagados).
EMAIL_URL=
DEFAULT_FROM_EMAIL=glitchtip@localhost
