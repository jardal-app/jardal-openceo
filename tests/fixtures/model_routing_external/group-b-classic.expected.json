{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "gemini": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Free Gemini (model_routing)",
      "options": {
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "apiKey": "{env:FREE_ROUTER_GEMINI_API_KEY}"
      },
      "models": {
        "gamma-flash": {
          "name": "example/gamma"
        }
      }
    },
    "groq": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Free Groq (model_routing)",
      "options": {
        "baseURL": "https://api.groq.com/openai/v1",
        "apiKey": "{env:FREE_ROUTER_GROQ_API_KEY}"
      },
      "models": {
        "gpt-alpha": {
          "name": "example/alpha"
        }
      }
    },
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Free NVIDIA (model_routing)",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:FREE_ROUTER_NVIDIA_NIM_API_KEY}"
      },
      "models": {
        "org-beta": {
          "name": "example/beta"
        }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Free OpenRouter (model_routing)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:FREE_ROUTER_OPENROUTER_API_KEY}"
      },
      "models": {
        "example-alpha:free": {
          "name": "example/alpha"
        }
      }
    }
  }
}
