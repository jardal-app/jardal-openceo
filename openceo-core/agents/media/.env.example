# Media skill environment manifest.
#
# Credentials for openceo-core/tools/media_transcribe.py
# (audio extraction with yt-dlp + Whisper STT on Groq).
# Use a dedicated Groq key so this tool bills separately from openceo-voice.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
# Optional: force a language (e.g. "es"). Empty = auto-detect.
GROQ_STT_LANGUAGE=
