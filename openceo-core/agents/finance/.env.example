# Finance skill environment manifest.
# For the bundled openceo-core runtime, copy these values into openceo-core/.env.finance.local.
# Do not persist CVV in a file. Inject it one-shot only when you execute a real payment.

FINANCE_BROWSER_HEADLESS=true
FINANCE_BROWSER_SLOW_MO_MS=0
FINANCE_ARTIFACTS_DIR=../.runtime/finance

ELFEC_LOGIN_URL=https://ecommerce.elfec.com/login
ELFEC_PAYMENT_URL=https://ecommerce.elfec.com/pagos/add/
ELFEC_TIMEOUT_MS=45000
ELFEC_HOUSE_USERNAME=
ELFEC_HOUSE_PASSWORD=
ELFEC_CARD_NUMBER=
ELFEC_CARD_EXPIRY=
