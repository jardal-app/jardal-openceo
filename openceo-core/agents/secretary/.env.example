# Secretary skill environment manifest.
# For the bundled openceo-core runtime, copy these values into openceo-core/.env.

# Optional LLM fallback for payload extraction.
DEEPSEEK_API_KEY=
CEO_LLM_MODEL=deepseek-chat
CEO_LLM_BASE_URL=https://api.deepseek.com/v1

# Shared SMTP sender used by the secretary skill.
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
SMTP_SSL_VERIFY=false
SMTP_TIMEOUT_SECONDS=30
SMTP_DEFAULT_SENDER=
SMTP_ACCOUNTS_JSON=
SMTP_IDENTITIES_PATH=config/email_identities.toml
SMTP_SIGNATURE_COMPANY=Jardal - Bolivia
SMTP_SIGNATURE_LOGO_PATH=../Isotipo.png
SMTP_SIGNATURE_LOGO_WIDTH=104
