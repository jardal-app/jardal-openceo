# Shared core environment.
# Agent-local manifests live in openceo-core/agents/*/.env.example.
# For the bundled runtime, merge the needed values into this file
# (and finance secrets into openceo-core/.env.finance.local).

# API authentication (Bearer token for /v1/ endpoints - used by OpenWebUI)
OPENCEO_API_KEY=

# MongoDB (servicio externo existente)
MONGODB_URL=mongodb://user:pass@jardal-mongo:27017/?authSource=admin
MONGODB_DATABASE=openceo

# OpenWebUI (servicio externo en jardal-internal-net)
OPENWEBUI_URL=http://openwebui:8080

# Voice backend variables now live in openceo-voice/.env.example

# n8n (servicio externo en jardal-internal-net)
N8N_URL=http://jardal-n8n:5678
N8N_API_KEY=

# Notion shared tool
NOTION_API_TOKEN=
NOTION_API_BASE_URL=https://api.notion.com/v1
NOTION_API_VERSION=2026-03-11
# data_source | database | page
NOTION_TICKETS_PARENT_KIND=data_source
NOTION_TICKETS_PARENT_ID=
# Solo aplica si el parent es database y hay mas de un data source
NOTION_TICKETS_DATA_SOURCE_NAME=
# Si se deja vacio, se autodetecta la propiedad title
NOTION_TICKETS_TITLE_PROPERTY=
# Mapa flexible campo canonico -> propiedad real de Notion
# Campos soportados: description, priority, status, project, ticket_type, source, source_id, tags, due_date, external_url
NOTION_TICKETS_PROPERTY_MAP_JSON={"priority":"Priority","status":"Status","project":"Project","source":"Source","source_id":"Source ID","tags":"Tags","due_date":"Due","external_url":"External URL"}
NOTION_TICKETS_DEFAULT_STATUS=
NOTION_TICKETS_DEFAULT_PRIORITY=
NOTION_TICKETS_DEFAULT_SOURCE=OpenCEO
NOTION_TICKETS_TEMPLATE_ID=
NOTION_TICKETS_USE_DEFAULT_TEMPLATE=false
NOTION_TICKETS_APPEND_DESCRIPTION_TO_BODY=true
NOTION_MIRROR_ENABLED=true

# Shared infrastructure tools
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DNS_DEFAULT_TARGET=91.99.9.106
CLOUDFLARE_DNS_DEFAULT_PROXIED=false
CLOUDFLARE_DNS_DEFAULT_TTL=1

# CEO routing LLM
DEEPSEEK_API_KEY=
CEO_LLM_MODEL=deepseek-v4-flash
CEO_LLM_BASE_URL=https://api.deepseek.com/v1

# Dev skill providers
CODEX_CLI_PATH=codex
CLAUDE_CODE_PATH=clauded
GEMINI_CLI_PATH=agyd
OPENCODE_CLI_PATH=opencode
GLM_CLI_PATH=clauded

CODEX_DEFAULT_ARGS=--dangerously-bypass-approvals-and-sandbox -m gpt-5.4 -c model_reasoning_effort=xhigh
CLAUDE_DEFAULT_ARGS=--dangerously-skip-permissions --model opus --effort high
GEMINI_DEFAULT_ARGS=
OPENCODE_DEFAULT_ARGS=-m deepseek/deepseek-reasoner
# OpenCode CLI guarda credenciales de /connect en ~/.local/share/opencode/auth.json.
# OPENCODE_GO_API_KEY queda expuesta aqui como conveniencia para scripts propios.
OPENCODE_GO_API_KEY=
# Si se define, OpenCEO reemplaza cualquier -m/--model del provider opencode con este modelo.
OPENCODE_MODEL_OVERRIDE=
# Catalogo OpenCode Go
# GLM-5: arquitectura, contratos e invariantes.
OPENCODE_GO_MODEL_GLM5=opencode-go/glm-5
# Kimi K2.5: mantenibilidad, UX y revisiones multimodales.
OPENCODE_GO_MODEL_KIMI_K25=opencode-go/kimi-k2.5
# MiniMax M2.5: implementacion economica y alto throughput.
OPENCODE_GO_MODEL_MINIMAX_M25=opencode-go/minimax-m2.5
# MiniMax M2.7: robustez de runtime, integracion y reemplazo fuerte de DeepSeek en OpenCode.
OPENCODE_GO_MODEL_MINIMAX_M27=opencode-go/minimax-m2.7
GLM_DEFAULT_ARGS=--dangerously-skip-permissions --model glm-4.5

# cli = real subprocess | mock = simulated responses
DEV_EXECUTION_MODE=cli
DEV_TURN_TIMEOUT_SECONDS=1800
DEV_IDLE_TIMEOUT_SECONDS=45
DEV_MAX_CONTEXT_MESSAGES=60
DEV_CONTEXT_MAX_CHARS=20000

TMUX_POLL_INTERVAL_MS=300
TMUX_TURN_TIMEOUT_SECONDS=600
TMUX_STABILITY_CHECKS=3

# Server
OPENCEO_HOST=0.0.0.0
OPENCEO_PORT=8000
WEBSOCKET_PATH=/ws
MCP_SERVER_ENABLED=true
MCP_SERVER_PATH=/internal/mcp
MCP_GLOBAL_PATH=/internal/mcp-global
MCP_SERVER_TRANSPORT=streamable-http
MCP_SERVER_INTERNAL_HOST=127.0.0.1
MCP_SERVER_ALLOWED_IPS=127.0.0.1/32,::1/128
# If empty, local MCP stays without Bearer auth and is protected only by loopback.
MCP_SERVER_API_KEY=

# Rate limit management
RATE_MAX_CONCURRENT_TICKETS=3
RATE_CODEX_RESERVE_5H=0.20
RATE_CODEX_RESERVE_WEEKLY=0.05
RATE_CLAUDE_RESERVE_5H=0.0
RATE_CLAUDE_RESERVE_WEEKLY=0.0
RATE_TIER_S_WEIGHT=3
RATE_NORMAL_WEIGHT=1
RATE_STATUS_STALE_SECONDS=300

# Runtime
TASK_AUTORUN=true
WAITING_POLL_SECONDS=60
PROJECTS_DIR=projects
DEFAULT_PROJECT=example-project

# Shared SMTP tool (used by secretary today, reusable by other skills)
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
SMTP_SSL_VERIFY=false
SMTP_TIMEOUT_SECONDS=30
SMTP_DEFAULT_SENDER=
SMTP_USER=
SMTP_PASS=
SMTP_ACCOUNTS_JSON=
SMTP_IDENTITIES_PATH=config/email_identities.toml
SMTP_SIGNATURE_COMPANY=Jardal - Bolivia
SMTP_SIGNATURE_LOGO_PATH=../Isotipo.png
SMTP_SIGNATURE_LOGO_WIDTH=104

# Finance note:
# - You can keep finance secrets in openceo-core/.env.finance.local
# - Do not hardcode real card data in source files
# - Do not persist CVV in env/files; inject it one-shot only when you really execute the final payment
