# Claves del router de modelos gratuitos (model_routing, TASK-2026-00283).
# Copia real: openceo-core/.env.free-router.local, permisos 0600. Nunca versionar una copia real.
# Separado de .env a propósito: allí GROQ_API_KEY es la clave de voz y puede ser de pago.
# Usar cuentas de nivel gratuito, sin método de pago ni recarga automática cuando sea posible.

# Obligatorias
# https://openrouter.ai/settings/keys - cupo :free por cuenta: 20 RPM; 50/día, 1.000/día tras USD 10 en créditos
FREE_ROUTER_OPENROUTER_API_KEY=
# https://build.nvidia.com - la prueba prohíbe enviar información confidencial
FREE_ROUTER_NVIDIA_NIM_API_KEY=
# https://console.groq.com/keys - cuenta gratuita, distinta de la de voz si esa es de pago
FREE_ROUTER_GROQ_API_KEY=
# https://aistudio.google.com/apikey - Gemini API, no Vertex; el nivel gratuito usa el contenido para mejorar productos
FREE_ROUTER_GEMINI_API_KEY=
# https://artificialanalysis.ai - Data API Free (100 solicitudes / 24 h), solo benchmarks
FREE_ROUTER_AA_API_KEY=

# Opcionales
# https://huggingface.co/settings/tokens - lectura; el dataset de LMArena es público
FREE_ROUTER_HF_TOKEN=

# Gateway local: no rellenar hasta aprobar TASK-2026-00298 (generar con: openssl rand -hex 32)
FREE_ROUTER_GATEWAY_KEY=
FREE_ROUTER_LITELLM_MASTER_KEY=
