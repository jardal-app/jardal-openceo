# Local-only finance secrets.
# Create a real copy as: openceo-core/.env.finance.local
# Never commit a real copy.

# ELFEC account
ELFEC_HOUSE_USERNAME=
ELFEC_HOUSE_PASSWORD=

# Optional and still sensitive.
# Prefer a secret manager or OS keyring instead of a flat file.
ELFEC_CARD_NUMBER=
ELFEC_CARD_EXPIRY=

# Do not persist CVV here.
# Pass it one-shot at execution time only.
# Example:
#   ELFEC_CARD_CVV_ONESHOT=888 scripts/openceo-core-host.sh restart

# --- ERPNext (agente Finance y adapter de tickets) ---
# Creado por el bootstrap 2026-09-22
# (jardal-erpnext/decision-2026-09-21-arquitectura-financiera-final.md §11).
# Usuario API exclusivo de OpenCEO, con permisos minimos.
ERPNEXT_URL=https://erp.jardal.app
ERPNEXT_USER=openceo@jardal.app
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# Contrasena desk (solo emergencia; el acceso normal es por API key)
ERPNEXT_PASSWORD=
# Zona IANA del sitio (exp_* son naive en hora local; Gantt 00147)
ERPNEXT_SITE_TIMEZONE=America/Caracas
